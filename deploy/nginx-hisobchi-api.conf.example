# Nginx HTTPS reverse proxy configuration for Hisobchi Mobile APK REST API
# 1. Replace `hisobchi.yourdomain.uz` with your actual domain name.
# 2. Place in `/etc/nginx/sites-available/hisobchi-api.conf` and symlink to `/etc/nginx/sites-enabled/`.
# 3. Run: sudo certbot --nginx -d hisobchi.yourdomain.uz

server {
    listen 80;
    server_name hisobchi.yourdomain.uz;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
