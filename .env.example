# Telegram Bot Token (@BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram User IDs (comma-separated; leave empty to allow private chat usage during setup)
ADMIN_IDS=

# Database URL (SQLite for quick start, PostgreSQL for production)
# Docker Compose PostgreSQL example: postgresql+asyncpg://hisobchi:strong_password@hisobchi-postgres:5432/hisobchi_db
DATABASE_URL=sqlite+aiosqlite:///./data/hisobot_bot.db

# Docker Compose PostgreSQL credentials (when using docker-compose.yml)
POSTGRES_USER=hisobchi
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=hisobchi_db

# Gemini AI API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# YesPOS API (Phase 2)
YESPOS_BASE_URL=https://marketplace.yestask.uz
YESPOS_API_KEY=
YESPOS_BRANCH_ID=1
YESPOS_1C_BASE_URL=
YESPOS_1C_API_KEY=

TIMEZONE=Asia/Tashkent

# Optional encryption password for daily Telegram backups (leave empty for plain .json.gz)
BACKUP_PASSWORD=
